<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by the Virgil .pkg to /Library/LaunchDaemons. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.virgil.virgild</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/virgild</string>
		<string>-c</string>
		<string>/Library/Application Support/Virgil/virgil.conf</string>
		<!-- virgild writes and rotates the log itself (5 MB, one old file
		     virgild.log.1); StandardErrorPath only catches what is printed
		     before it opens the file. -->
		<string>--log</string>
		<string>/Library/Logs/Virgil/virgild.log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<!-- Real-time audio: keep the daemon out of App Nap / background QoS. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Virgil/virgild.log</string>
</dict>
</plist>
