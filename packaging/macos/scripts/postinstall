#!/bin/sh
SUPPORT="/Library/Application Support/DSV"
PLIST=/Library/LaunchDaemons/org.dsv.dsvd.plist

# Keep a user-edited configuration on upgrade.
if [ ! -f "$SUPPORT/dsv.conf" ]; then
	cp "$SUPPORT/dsv.conf.default" "$SUPPORT/dsv.conf"
fi
chmod 664 "$SUPPORT/dsv.conf"
chgrp admin "$SUPPORT/dsv.conf" 2>/dev/null || true
mkdir -p /Library/Logs/DSV

chown root:wheel "$PLIST"
chmod 644 "$PLIST"
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true

# Load the new HAL plug-in. coreaudiod is relaunched by launchd.
killall coreaudiod 2>/dev/null || true
exit 0
