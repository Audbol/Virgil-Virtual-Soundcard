[Unit]
Description=Virgil Dante-compatible virtual soundcard
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/virgild -c /etc/virgil/virgil.conf
Restart=on-failure
# Low-latency audio: real-time scheduling, locked memory, PTP ports < 1024.
LimitRTPRIO=95
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE CAP_IPC_LOCK
# A fixed system account (created by the package) that owns /etc/virgil, so
# settings saved from the control panel can be written.
User=virgil
Group=virgil
# Inferno keeps Dante subscriptions and the device identity under $HOME.
StateDirectory=virgil
Environment=HOME=/var/lib/virgil XDG_STATE_HOME=/var/lib/virgil
# The shared-memory soundcard is made accessible explicitly (fchmod); other
# files the service writes (settings, Dante state) stay private-writable.
UMask=0022

[Install]
WantedBy=multi-user.target
