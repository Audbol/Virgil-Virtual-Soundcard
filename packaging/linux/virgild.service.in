[Unit]
Description=Virgil Dante-compatible virtual soundcard
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/virgild -c /etc/virgil/virgil.conf
Restart=on-failure
# Low-latency audio: real-time scheduling, locked memory, PTP ports < 1024.
LimitRTPRIO=95
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE CAP_IPC_LOCK
DynamicUser=yes
# The shared-memory soundcard must be reachable by desktop users.
UMask=0000

[Install]
WantedBy=multi-user.target
