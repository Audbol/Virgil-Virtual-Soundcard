# DSV virtual soundcard configuration.
# Copy to /etc/dsv/dsv.conf (Linux), /Library/Application Support/DSV/dsv.conf
# (macOS) or %ProgramData%\DSV\dsv.conf (Windows) and run: dsvd -c <file>

[device]
name = DSV Virtual Soundcard
# NIC on the Dante / AES67 network: interface name or its IPv4 address.
interface = eth0
sample_rate = 48000
# Channels apps play into the network / record from the network.
tx_channels = 8
rx_channels = 8
# AES67 packet time. 1000 is the AES67 default and what Dante uses for
# AES67 flows; 250 or 125 lower latency on networks that support it.
packet_time_us = 1000
# Receive latency (jitter buffer). Like Dante's per-device latency setting:
# 1000-2000 us on a clean gigabit LAN, more across switches/Wi-Fi.
latency_us = 2000
# Playback safety margin ahead of the media clock (0 = 2 packets).
# Raise it if you hear dropouts on a busy or non-real-time system.
tx_lead_us = 0
# Real-time scheduling (Linux SCHED_FIFO priority / macOS time-constraint /
# Windows MMCSS "Pro Audio"). Busy-wait this long before each packet.
rt_priority = 80
spin_us = 50
lock_memory = true
# ptp = follow the network grandmaster (required for Dante/AES67);
# free = local clock only (testing, or when DSV is the only device).
clock = ptp
# Announce our flows and discover others via SAP.
sap = true

[ptp]
domain = 0
# Become grandmaster if none is present (priority 250 loses to real GMs).
master_capable = true
priority1 = 250

# ---- Transmit flows (computer -> network) ------------------------------
# A flow carries at most 8 channels of L24 at 1 ms (1500-byte MTU).
[tx]
name = DSV 1-8
address = 239.69.83.67
port = 5004
first_channel = 1
channels = 8

# ---- Receive flows (network -> computer) -------------------------------
# Follow a flow announced via SAP, e.g. a Dante device's AES67 multicast
# flow. 'dsvd --discover' lists the exact names on your network.
[rx]
sap_name = Y001-Yamaha-Ri8-D-14c7cc : 32
first_channel = 1
channels = 8

# Or subscribe to a fixed multicast group:
# [rx]
# address = 239.69.10.20
# port = 5004
# first_channel = 1
# channels = 2
# ts_offset = 0
